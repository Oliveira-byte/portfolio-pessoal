# Referência de variáveis de ambiente. O projeto não carrega este arquivo automaticamente.
# Para Windows/PowerShell, use os comandos de ETAPA-10.md.
SITE_URL=http://127.0.0.1:8000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=nao-responda@example.com
EMAIL_REPLY_TO=
EMAIL_EQUIPE=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_ENVIO_IMEDIATO=true
EMAIL_NOTIFICACOES_ATIVAS=true
# Em produção, configure DJANGO_SECRET_KEY com uma chave própria e persistente.
